# Synthesis + place & route for the Tang Nano 20K, driven by gw_sh.
# Run from the fpga/ directory:  make bit
#
# Outputs land in impl/pnr/soc816.fs (the bitstream) alongside the timing and
# resource reports.

set_device -name GW2AR-18C GW2AR-LV18QN88C8/I7

add_file -type verilog ../cpu_65c816.v
# Glob rather than listing files: adding a module and forgetting to list it
# here fails late, as an "unknown module" black box during synthesis.
foreach f [lsort [glob rtl/*.v]] { add_file -type verilog $f }
# The SIDs (reDIP SID, CERN-OHL-S v2) are SystemVerilog; the package first.
add_file -type verilog rtl/sid/sid_pkg.sv
foreach f [lsort [glob rtl/sid/*.sv]] {
    if {$f ne "rtl/sid/sid_pkg.sv"} { add_file -type verilog $f }
}
add_file -type cst   tang_nano_20k.cst
add_file -type sdc   tang_nano_20k.sdc

# rom_path.vh is generated by `make` and lives in rtl/.
set_option -include_path [file join [pwd] rtl]
set_option -top_module top_tang20k
# SystemVerilog for the SIDs; the rest of the design is plain Verilog-2001,
# which reads the same under it.
set_option -verilog_std sysv2017
# Pins 54-56 (I2S) double as SSPI configuration pins.
set_option -use_sspi_as_gpio 1
set_option -output_base_name soc816

run all
